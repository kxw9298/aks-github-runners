ometry x="720" y="1070" width="980" height="124" as="geometry"/></mxCell><mxCell id="c119" value="DR cluster" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=10;fontColor=#1F1F1F;labelBackgroundColor=none;image=img/lib/azure2/containers/Kubernetes_Services.svg;fontFamily=Segoe UI;" vertex="1" parent="c118"><mxGeometry x="40" y="32" width="40" height="40" as="geometry"/></mxCell><mxCell id="c120" value="ACR geo-replica" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=10;fontColor=#1F1F1F;labelBackgroundColor=none;image=img/lib/azure2/containers/Container_Registries.svg;fontFamily=Segoe UI;" vertex="1" parent="c118"><mxGeometry x="210" y="32" width="40" height="40" as="geometry"/></mxCell><mxCell id="c121" value="Key Vault&lt;br&gt;same App keys" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=10;fontColor=#1F1F1F;labelBackgroundColor=none;image=img/lib/azure2/security/Key_Vaults.svg;fontFamily=Segoe UI;" vertex="1" parent="c118"><mxGeometry x="380" y="32" width="40" height="40" as="geometry"/></mxCell><mxCell id="c122" value="Event Hubs and&lt;br&gt;collectors" style="image;aspect=fixed;html=1;points=[];align=center;verticalLabelPosition=bottom;verticalAlign=top;fontSize=10;fontColor=#1F1F1F;labelBackgroundColor=none;image=img/lib/azure2/analytics/Event_Hubs.svg;fontFamily=Segoe UI;" vertex="1" parent="c118"><mxGeometry x="550" y="32" width="40" height="40" as="geometry"/></mxCell><mxCell id="c123" value="&lt;b&gt;Failover&lt;/b&gt;&lt;br&gt;Raise maxRunners on the DR scale sets, or let GitHub route jobs to whichever cluster is online" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#3B3B3B;spacing=0;overflow=visible;fontFamily=Segoe UI;" vertex="1" parent="c118"><mxGeometry x="710" y="28" width="260" height="84" as="geometry"/></mxCell><mxCell id="c124" value="&lt;b&gt;Design notes&lt;/b&gt;&lt;br&gt;• Build and test jobs run pull-request code, so they run only in the nonprod cluster. The prod cluster runs only deploy runners, limited to approved workflows.&lt;br&gt;• Each org gets its own GitHub App per environment, namespace, tainted node pool and Key Vault; admission policy enforces placement.&lt;br&gt;• All egress leaves through Azure Firewall, and the runner subnet's NSG blocks the shared services. Runner pods and runner nodes scale to zero when idle." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#BDBDBD;dashed=1;dashPattern=3 3;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=10.5;fontColor=#1F1F1F;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="1214" width="1680" height="92" as="geometry"/></mxCell><mxCell id="c125" value="outbound 443" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#6E6E6E;strokeWidth=1.25;fontSize=10;fontColor=#3B3B3B;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;dashed=1;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.2042;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c26" target="c3"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c126" value="VNet peering" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1F6FB2;strokeWidth=2;startArrow=oval;startFill=0;endArrow=oval;endFill=0;startSize=9;endSize=9;fontSize=10;fontColor=#1F6FB2;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=0.0000;exitY=0.6650;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.9429;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c43" target="c24"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c127" value="VNet peering" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1F6FB2;strokeWidth=2;startArrow=oval;sta